# ============================================================================
# CONFIGURACIÓN GENERAL DEL PROYECTO (MODELO MULTI-INSTANCIA / MARCA BLANCA)
# ============================================================================
PROJECT_NAME="Sistema Core API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Configuración de Seguridad y Criptografía JWT
SECRET_KEY="cambiar_por_una_clave_secreta_segura_de_32_caracteres_minimo"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Credenciales de PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sistema_db

# Cadena de conexión asíncrona completa (PostgreSQL + asyncpg)
# Formato: postgresql+asyncpg://<usuario>:<password>@<host>:<puerto>/<nombre_db>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sistema_db
